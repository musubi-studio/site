---
import "../styles/global.css";
import { strings, LOCALES, type Locale } from "../i18n/strings";
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from "astro:i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = strings[lang];
const CONTACT_EMAIL = "hello@musubi.lat";

// Simple {em}...{/em} marker → <em> for the two headline strings that need
// inline emphasis. Content is fully author-controlled (never user input).
function emphasize(str: string) {
  return str.replace(/\{em\}/g, "<em>").replace(/\{\/em\}/g, "</em>");
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />

    <link rel="canonical" href={getAbsoluteLocaleUrl(lang)} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("en")} />

    {
      import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Grain overlay -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Mobile menu overlay -->
    <div
      class="mobile-menu"
      id="mobile-menu"
      role="dialog"
      aria-label={t.nav.ariaLabel}
      aria-hidden="true"
    >
      <a href="#capabilities" class="mobile-nav-link">{t.nav.work}</a>
      <a href="#philosophy" class="mobile-nav-link">{t.nav.approach}</a>
      <a href="#contact" class="mobile-nav-link" data-umami-event="nav-contact-mobile"
        >{t.nav.contact}</a
      >
      <div class="mobile-lang-switch">
        {
          LOCALES.map((l) => (
            <a
              href={getRelativeLocaleUrl(l)}
              class="lang-link"
              aria-current={l === lang ? "page" : undefined}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Header -->
    <header class="site-header" id="site-header">
      <div class="site-header-inner">
        <a href="#top" class="brand" aria-label={t.nav.home}>
          <img src="/isotype.png" alt="Musubi" width="36" height="36" />
          <span class="wordmark">Musubi</span>
        </a>
        <nav class="desktop-nav">
          <a href="#capabilities" class="nav-link">{t.nav.work}</a>
          <a href="#philosophy" class="nav-link">{t.nav.approach}</a>
          <a href="#contact" class="nav-link" data-umami-event="nav-contact"
            >{t.nav.contact}</a
          >
          <span class="lang-switch" aria-label="Language">
            {
              LOCALES.map((l, i) => (
                <>
                  {i > 0 && (
                    <span class="lang-sep" aria-hidden="true">
                      /
                    </span>
                  )}
                  <a
                    href={getRelativeLocaleUrl(l)}
                    class="lang-link"
                    aria-current={l === lang ? "page" : undefined}
                  >
                    {l.toUpperCase()}
                  </a>
                </>
              ))
            }
          </span>
        </nav>
        <button
          class="hamburger"
          id="hamburger"
          aria-label={t.nav.toggleMenu}
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <main id="top">
      <!-- Hero -->
      <section class="hero">
        <div class="container">
          <div class="hero-grid">
            <div>
              <p class="eyebrow hero-enter" style="--delay:80ms">
                <span class="eyebrow-rule" aria-hidden="true"></span>
                {t.hero.eyebrow}
              </p>
              <h1
                class="hero-enter"
                style="--delay:200ms"
                set:html={emphasize(t.hero.heading)}
              />
              <p class="hero-sub hero-enter" style="--delay:340ms">
                {t.hero.sub}
              </p>
              <div class="hero-actions hero-enter" style="--delay:460ms">
                <a href="#contact" class="cta-btn" data-umami-event="hero-cta-contact"
                  >{t.hero.ctaContact}</a
                >
                <a
                  href="#capabilities"
                  class="cta-btn cta-btn--ghost"
                  data-umami-event="hero-cta-work">{t.hero.ctaWork}</a
                >
              </div>
            </div>

            <div class="hero-enter" style="--delay:300ms">
              <canvas id="hero-graph"></canvas>
              <p class="hero-caption">
                <span class="kanji">結び</span>
                {t.hero.captionKanji}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Capabilities -->
      <section
        id="capabilities"
        class="capabilities reveal"
        style="scroll-margin-top:96px"
      >
        <div class="container">
          <p class="eyebrow">{t.capabilities.eyebrow}</p>
          <h2>{t.capabilities.heading}</h2>
          <div class="capabilities-grid">
            {
              t.capabilities.items.map((c, i) => (
                <div class="capability-item" data-stagger style={`--i:${i}`}>
                  <span class="num">{c.no}</span>
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Projects -->
      <section id="projects" class="projects reveal" style="scroll-margin-top:96px">
        <div class="container">
          <h2>{t.projects.heading}</h2>
          <div class="projects-list">
            {
              t.projects.items.map((p, i) => (
                <div class="project-item" data-stagger style={`--i:${i}`} tabindex="0">
                  <span class="project-tag">{p.tag}</span>
                  <p class="project-problem">{p.problem}</p>
                  <div class="project-body-wrap">
                    <p class="project-body">{p.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Philosophy -->
      <section id="philosophy" class="philosophy reveal" style="scroll-margin-top:96px">
        <div class="container" style="max-width:768px">
          <p class="eyebrow">{t.philosophy.eyebrow}</p>
          <blockquote set:html={emphasize(t.philosophy.quote)} />
          <div class="rule-draw" aria-hidden="true"></div>
          <ul class="principles">
            {
              t.philosophy.principles.map((p, i) => (
                <li data-stagger style={`--i:${i}`}>
                  {p}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="closing-cta reveal" style="scroll-margin-top:96px">
        <div class="container">
          <h2>{t.contact.heading}</h2>
          <p>
            {t.contact.sub}
          </p>

          <div class="contact-options">
            <button
              type="button"
              id="contact-btn-form"
              class="cta-btn cta-btn--outline contact-option-btn"
              data-umami-event="closing-cta-form"
              aria-pressed="false"
              aria-controls="contact-form-wrap">{t.contact.toggleForm}</button
            >
            <button
              type="button"
              id="contact-btn-call"
              class="cta-btn cta-btn--outline contact-option-btn"
              data-umami-event="closing-cta-calendly"
              aria-pressed="false"
              aria-controls="contact-calendly-wrap">{t.contact.toggleCall}</button
            >
          </div>

          <div class="contact-form-wrap" id="contact-form-wrap" hidden>
            <form id="contact-form" class="contact-form" novalidate>
              <input type="hidden" name="lang" value={lang} />
              <div class="form-row">
                <label for="cf-name">{t.contact.formName}</label>
                <input id="cf-name" name="name" type="text" required maxlength="200" />
              </div>
              <div class="form-row">
                <label for="cf-email">{t.contact.formEmail}</label>
                <input id="cf-email" name="email" type="email" required maxlength="200" />
              </div>
              <div class="form-row">
                <label for="cf-subject"
                  >{t.contact.formSubject}
                  <span class="form-optional">{t.contact.formSubjectOptional}</span
                  ></label
                >
                <input id="cf-subject" name="subject" type="text" maxlength="200" />
                <p class="form-hint">
                  {t.contact.formSubjectHint}
                </p>
              </div>
              <div class="form-row">
                <label for="cf-message">{t.contact.formMessage}</label>
                <textarea
                  id="cf-message"
                  name="message"
                  required
                  maxlength="5000"
                  rows="5"></textarea>
              </div>
              <!-- honeypot — hidden from real visitors, never labeled as real -->
              <div class="form-hp" aria-hidden="true">
                <input name="company" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <button type="submit" class="cta-btn" data-umami-event="contact-form-submit"
                >{t.contact.formSubmit}</button
              >
              <p class="form-status" id="contact-form-status" role="status"></p>
            </form>
          </div>

          <div class="contact-calendly-wrap" id="contact-calendly-wrap" hidden>
            <div
              class="calendly-inline-widget"
              data-url="https://calendly.com/musubi-studio/30min?hide_landing_page_details=1"
              style="min-width:320px;height:700px"
            >
            </div>
          </div>

          <p class="form-fallback">
            {t.contact.formFallbackPrefix}
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            {t.contact.formFallbackSuffix}
          </p>

          <p class="privacy-note">
            <strong>{t.contact.privacyLabel}</strong> — {t.contact.privacyBody}
          </p>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer-inner">
          <a href="#top" class="brand" aria-label={t.nav.home}>
            <img src="/isotype.png" alt="Musubi" width="28" height="28" />
            <span class="wordmark">Musubi</span>
          </a>
          <ul class="footer-nav">
            <li><a href="#capabilities" class="nav-link">{t.nav.work}</a></li>
            <li><a href="#philosophy" class="nav-link">{t.nav.approach}</a></li>
            <li>
              <a
                href={`mailto:${CONTACT_EMAIL}`}
                class="nav-link"
                data-umami-event="footer-contact">{CONTACT_EMAIL}</a
              >
            </li>
          </ul>
          <p class="footer-copyright">© {new Date().getFullYear()} Musubi</p>
        </div>
        <p class="credits">
          {t.footer.credits}
          <a href="https://www.vecteezy.com" target="_blank" rel="noopener noreferrer"
            >Vecteezy.com</a
          >
        </p>
      </div>
    </footer>

    <script>
      (function () {
        const canvas = document.getElementById("hero-graph");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");

        const CLAY = "#E85D3D";
        const BLUE = "#1D4ED8";
        const INDIGO = "#2B4F82";
        const CARBON = "#323232";

        const N = 58; // node count
        let W = 0,
          H = 0,
          R = 0;
        let nodes3D = [],
          edges = [];
        let rotX = 0.18,
          rotY = 0;
        const mouse = { nx: 0.5, ny: 0.5, over: false }; // normalised 0-1

        // Fibonacci sphere — evenly distributed N points on unit sphere
        function buildSphere(radius) {
          const golden = Math.PI * (3 - Math.sqrt(5));
          return Array.from({ length: N }, (_, i) => {
            const y = 1 - (i / (N - 1)) * 2;
            const r = Math.sqrt(1 - y * y);
            const th = golden * i;
            // colour & size by index
            let color, nr;
            if (i === 0 || i === Math.round(N * 0.55)) {
              color = CLAY;
              nr = 6.5;
            } else if (i % 13 === 0) {
              color = CLAY;
              nr = 4.5;
            } else if (i % 7 === 0) {
              color = BLUE;
              nr = 4;
            } else if (i % 5 === 0) {
              color = INDIGO;
              nr = 3.5;
            } else {
              color = CARBON;
              nr = 2.4;
            }
            return {
              bx: r * Math.cos(th) * radius,
              by: y * radius,
              bz: r * Math.sin(th) * radius,
              // projected
              px: 0,
              py: 0,
              pz: 0,
              pscale: 1,
              color,
              r: nr,
            };
          });
        }

        // Connect nodes closer than `thresh` chord distance
        function buildEdges(ns, thresh) {
          const result = [];
          for (let i = 0; i < ns.length; i++) {
            for (let j = i + 1; j < ns.length; j++) {
              const dx = ns[i].bx - ns[j].bx;
              const dy = ns[i].by - ns[j].by;
              const dz = ns[i].bz - ns[j].bz;
              if (dx * dx + dy * dy + dz * dz < thresh * thresh) result.push([i, j]);
            }
          }
          return result;
        }

        function init() {
          const dpr = window.devicePixelRatio || 1;
          const rect = canvas.getBoundingClientRect();
          if (!rect.width) return;
          W = rect.width;
          H = rect.height;
          canvas.width = W * dpr;
          canvas.height = H * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          R = Math.min(W, H) * 0.46;
          nodes3D = buildSphere(R);
          edges = buildEdges(nodes3D, R * 0.72);
        }

        // Rotate (bx,by,bz) by angles rx (pitch) and ry (yaw)
        function rotatePoint(bx, by, bz, rx, ry) {
          const cy = Math.cos(ry),
            sy = Math.sin(ry);
          const x1 = bx * cy + bz * sy;
          const z1 = -bx * sy + bz * cy;
          const cx2 = Math.cos(rx),
            sx2 = Math.sin(rx);
          return { x: x1, y: by * cx2 - z1 * sx2, z: by * sx2 + z1 * cx2 };
        }

        // Perspective project
        function project(x, y, z) {
          const fov = 420;
          const s = fov / (fov + z + R * 0.6);
          return { px: W * 0.5 + x * s, py: H * 0.5 + y * s, scale: s };
        }

        function ringColor(color, alpha) {
          if (color === CLAY) return `rgba(232,93,61,${alpha})`;
          if (color === BLUE) return `rgba(37,99,235,${alpha})`;
          if (color === INDIGO) return `rgba(43,79,130,${alpha})`;
          return `rgba(50,50,50,${alpha})`;
        }

        let lastT = 0;
        function tick(t) {
          requestAnimationFrame(tick);
          if (!W || !H || !nodes3D.length) return;
          lastT = t;

          // Auto-rotate + gentle wobble
          rotY += 0.0035;
          const wobble = Math.sin(t * 0.00028) * 0.06;

          // Mouse tilt (lerp toward target)
          const targetX = mouse.over ? (mouse.ny - 0.5) * 0.9 : 0.18;
          const targetY = mouse.over ? rotY + (mouse.nx - 0.5) * 0.04 : rotY;
          rotX += (targetX - rotX) * 0.04;
          if (mouse.over) rotY += (mouse.nx - 0.5) * 0.02;

          // Project all nodes
          for (const n of nodes3D) {
            const { x, y, z } = rotatePoint(n.bx, n.by, n.bz, rotX + wobble, rotY);
            n.pz = z;
            const p = project(x, y, z);
            n.px = p.px;
            n.py = p.py;
            n.pscale = p.scale;
          }

          ctx.clearRect(0, 0, W, H);

          // Edges — depth-faded
          for (const [i, j] of edges) {
            const a = nodes3D[i],
              b = nodes3D[j];
            const avgZ = (a.pz + b.pz) / 2;
            const depth = (avgZ + R) / (2 * R); // 0 back → 1 front
            const alpha = (0.04 + depth * 0.13).toFixed(3);
            ctx.beginPath();
            ctx.moveTo(a.px, a.py);
            ctx.lineTo(b.px, b.py);
            ctx.strokeStyle = `rgba(17,17,19,${alpha})`;
            ctx.lineWidth = 0.7;
            ctx.stroke();
          }

          // Nodes — back-to-front (painter's algorithm)
          const sorted = nodes3D.slice().sort((a, b) => a.pz - b.pz);
          for (const n of sorted) {
            const depth = (n.pz + R) / (2 * R); // 0 back → 1 front
            const alpha = 0.28 + depth * 0.72;
            const nr = Math.max(n.r * n.pscale * (W / 280), 1);

            // Soft glow ring for larger front nodes
            if (depth > 0.6 && n.r >= 3.5) {
              ctx.beginPath();
              ctx.arc(n.px, n.py, nr + 3.5, 0, Math.PI * 2);
              ctx.fillStyle = ringColor(n.color, (alpha * 0.16).toFixed(3));
              ctx.fill();
            }

            ctx.globalAlpha = Math.min(alpha, 1);
            ctx.beginPath();
            ctx.arc(n.px, n.py, nr, 0, Math.PI * 2);
            ctx.fillStyle = n.color;
            ctx.fill();
            ctx.globalAlpha = 1;
          }
        }

        canvas.addEventListener("mousemove", (e) => {
          const r = canvas.getBoundingClientRect();
          mouse.nx = (e.clientX - r.left) / W;
          mouse.ny = (e.clientY - r.top) / H;
          mouse.over = true;
        });
        canvas.addEventListener("mouseleave", () => {
          mouse.over = false;
        });

        const ro = new ResizeObserver(() => {
          init();
        });
        ro.observe(canvas);

        init();
        requestAnimationFrame(tick);
      })();
    </script>

    <script>
      // Header scroll state
      const header = document.getElementById("site-header");
      const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Hero entrance
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced) {
        document.body.classList.add("is-loaded");
      } else {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.body.classList.add("is-loaded"))
        );
      }

      // Nav active section
      const sections = document.querySelectorAll("section[id]");
      const navLinks = document.querySelectorAll(".desktop-nav .nav-link[href^='#']");
      if (sections.length && navLinks.length) {
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                navLinks.forEach((link) =>
                  link.classList.toggle(
                    "is-active",
                    link.getAttribute("href") === `#${entry.target.id}`
                  )
                );
              }
            }
          },
          { rootMargin: "-30% 0px -60% 0px", threshold: 0 }
        );
        sections.forEach((s) => sectionObserver.observe(s));
      }
    </script>

    <script>
      const btn = document.getElementById("hamburger");
      const menu = document.getElementById("mobile-menu");

      function openMenu() {
        menu.classList.add("is-open");
        menu.setAttribute("aria-hidden", "false");
        btn.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }
      function closeMenu() {
        menu.classList.remove("is-open");
        menu.setAttribute("aria-hidden", "true");
        btn.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }

      btn.addEventListener("click", () => {
        btn.getAttribute("aria-expanded") === "true" ? closeMenu() : openMenu();
      });

      // Close on link click
      menu.querySelectorAll(".mobile-nav-link").forEach((a) => {
        a.addEventListener("click", closeMenu);
      });

      // Close on Escape
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeMenu();
      });
    </script>

    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealEls = document.querySelectorAll(".reveal");
      if (reduced) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>

    <script>
      const btnForm = document.getElementById("contact-btn-form");
      const btnCall = document.getElementById("contact-btn-call");
      const wrapForm = document.getElementById("contact-form-wrap");
      const wrapCall = document.getElementById("contact-calendly-wrap");
      const contactSection = document.getElementById("contact");

      if (btnForm && btnCall && wrapForm && wrapCall && contactSection) {
        let calendlyLoaded = false;

        function showPanel(which) {
          const showForm = which === "form";
          const showCall = which === "call";

          btnForm.classList.toggle("cta-btn--outline", !showForm);
          btnCall.classList.toggle("cta-btn--outline", !showCall);
          btnForm.setAttribute("aria-pressed", String(showForm));
          btnCall.setAttribute("aria-pressed", String(showCall));

          if (showForm) {
            wrapForm.hidden = false;
            requestAnimationFrame(() => wrapForm.classList.add("is-open"));
            document.getElementById("cf-name")?.focus();
          } else {
            wrapForm.classList.remove("is-open");
            wrapForm.hidden = true;
          }

          if (showCall) {
            if (!calendlyLoaded) {
              const s = document.createElement("script");
              s.src = "https://assets.calendly.com/assets/external/widget.js";
              s.async = true;
              document.head.appendChild(s);
              calendlyLoaded = true;
            }
            wrapCall.hidden = false;
            requestAnimationFrame(() => wrapCall.classList.add("is-open"));
          } else {
            wrapCall.classList.remove("is-open");
            wrapCall.hidden = true;
          }
        }

        btnForm.addEventListener("click", () => {
          showPanel(btnForm.getAttribute("aria-pressed") === "true" ? null : "form");
        });
        btnCall.addEventListener("click", () => {
          showPanel(btnCall.getAttribute("aria-pressed") === "true" ? null : "call");
        });

        new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) showPanel(null);
            }
          },
          { threshold: 0 }
        ).observe(contactSection);
      }
    </script>

    <script define:vars={{ t: t.contact }}>
      const form = document.getElementById("contact-form");
      const status = document.getElementById("contact-form-status");
      if (form && status) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const data = Object.fromEntries(new FormData(form));
          const submitBtn = form.querySelector('button[type="submit"]');

          submitBtn.disabled = true;
          status.textContent = t.statusSending;
          status.className = "form-status";

          try {
            const res = await fetch("/api/contact", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify(data),
            });
            const result = await res.json();

            if (res.ok && result.ok) {
              status.textContent = t.statusOk;
              status.className = "form-status form-status--ok";
              form.reset();
            } else {
              status.textContent = result.error || t.statusErrorGeneric;
              status.className = "form-status form-status--error";
            }
          } catch {
            status.textContent = t.statusErrorNetwork;
            status.className = "form-status form-status--error";
          } finally {
            submitBtn.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
