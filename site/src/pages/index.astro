---
import "../styles/global.css";

const CONTACT_EMAIL = "hello@musubi.lat";

const capabilities = [
  {
    no: "01",
    title: "Connect",
    body: "Tie together the systems and data your team already has — no rip-and-replace.",
  },
  {
    no: "02",
    title: "Integrate",
    body: "Make disconnected tools work as one, without a platform migration.",
  },
  {
    no: "03",
    title: "Automate",
    body: "Take repetitive work off your team's plate, safely and incrementally.",
  },
  { no: "04", title: "Scale", body: "Grow what already works instead of rebuilding it." },
];

const projects = [
  {
    tag: "Data platform",
    problem:
      "Your data lives in databases, spreadsheets, and SaaS tools — but there's no single place to query it.",
    body: "We design and build the platform layer: ingestion, storage, transformation. Something your team can own without a dedicated engineering org.",
  },
  {
    tag: "Legacy modernization",
    problem:
      "Reports take hours to run. The BI tool nobody remembers buying is still running critical dashboards.",
    body: "We migrate what matters, retire what doesn't, and replace brittle pipelines with something maintainable — without stopping the business while we do it.",
  },
  {
    tag: "DataOps",
    problem:
      "Deployments need manual steps. Pipelines break silently. Nobody knows what the cloud bill is actually for.",
    body: "We bring CI/CD, observability, and cost tracking to your data workflows so failures are caught early and infrastructure is understood.",
  },
  {
    tag: "Data governance",
    problem:
      "Access controls exist in a spreadsheet. Nobody knows where a number comes from. Compliance is a document, not a system.",
    body: "We implement governance that's enforced by the platform — data contracts, lineage, attribute-based access — not by good intentions.",
  },
  {
    tag: "AI-assisted workflows",
    problem:
      "Your team spends time on repetitive work that a well-configured agent could handle.",
    body: "We deploy AI agents that accelerate data engineering work and assistants that enforce standards across teams — using the same tools we use internally.",
  },
];

const principles = [
  "We don't replace systems for the sake of it. We connect what already works.",
  "We don't design giant platforms. We compose small pieces.",
  "We don't deliver projects. We build capabilities.",
  "We build systems the client's team can understand, operate, and extend.",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>Musubi — Engineering studio for growing companies</title>
    <meta
      name="description"
      content="Musubi designs and builds automations, data platforms, and AI systems through small, measurable, incremental delivery."
    />

    {
      import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Grain overlay -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Mobile menu overlay -->
    <div
      class="mobile-menu"
      id="mobile-menu"
      role="dialog"
      aria-label="Navigation"
      aria-hidden="true"
    >
      <a href="#capabilities" class="mobile-nav-link">Work</a>
      <a href="#philosophy" class="mobile-nav-link">Approach</a>
      <a href="#contact" class="mobile-nav-link" data-umami-event="nav-contact-mobile"
        >Contact</a
      >
    </div>

    <!-- Header -->
    <header class="site-header" id="site-header">
      <div class="site-header-inner">
        <a href="#top" class="brand" aria-label="Musubi home">
          <img src="/isotype.png" alt="Musubi" width="36" height="36" />
          <span class="wordmark">Musubi</span>
        </a>
        <nav class="desktop-nav">
          <a href="#capabilities" class="nav-link">Work</a>
          <a href="#philosophy" class="nav-link">Approach</a>
          <a href="#contact" class="nav-link" data-umami-event="nav-contact">Contact</a>
        </nav>
        <button
          class="hamburger"
          id="hamburger"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <main id="top">
      <!-- Hero -->
      <section class="hero">
        <div class="container">
          <div class="hero-grid">
            <div>
              <p class="eyebrow hero-enter" style="--delay:80ms">
                <span class="eyebrow-rule" aria-hidden="true"></span>
                Engineering studio
              </p>
              <h1 class="hero-enter" style="--delay:200ms">
                We tie the loose ends into systems that{" "}
                <em>simply work</em>.
              </h1>
              <p class="hero-sub hero-enter" style="--delay:340ms">
                Musubi designs and builds automations, data platforms, and AI systems for
                growing companies — delivered in small, measurable increments.
              </p>
              <div class="hero-actions hero-enter" style="--delay:460ms">
                <a href="#contact" class="cta-btn" data-umami-event="hero-cta-contact"
                  >Start a conversation</a
                >
                <a
                  href="#capabilities"
                  class="cta-btn cta-btn--ghost"
                  data-umami-event="hero-cta-work">See what we do</a
                >
              </div>
            </div>

            <div class="hero-enter" style="--delay:300ms">
              <canvas id="hero-graph"></canvas>
              <p class="hero-caption">
                <span class="kanji">結び</span> — musubi, to bind and connect.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Capabilities -->
      <section
        id="capabilities"
        class="capabilities reveal"
        style="scroll-margin-top:96px"
      >
        <div class="container">
          <p class="eyebrow">What we do</p>
          <h2>Four ways we help you move.</h2>
          <div class="capabilities-grid">
            {
              capabilities.map((c, i) => (
                <div class="capability-item" data-stagger style={`--i:${i}`}>
                  <span class="num">{c.no}</span>
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Projects -->
      <section id="projects" class="projects reveal" style="scroll-margin-top:96px">
        <div class="container">
          <h2>Five problems we've solved before.</h2>
          <div class="projects-list">
            {
              projects.map((p, i) => (
                <div class="project-item" data-stagger style={`--i:${i}`} tabindex="0">
                  <span class="project-tag">{p.tag}</span>
                  <p class="project-problem">{p.problem}</p>
                  <div class="project-body-wrap">
                    <p class="project-body">{p.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Philosophy -->
      <section id="philosophy" class="philosophy reveal" style="scroll-margin-top:96px">
        <div class="container" style="max-width:768px">
          <p class="eyebrow">Approach</p>
          <blockquote>
            Software ages when it tries to solve everything on day one. We prefer small,
            understandable, evolvable systems — each delivery solving a real problem,
            integrating with what exists, and leaving the path open for the next step. The
            best technology is the one that <em>disappears</em> behind people's work.
          </blockquote>
          <div class="rule-draw" aria-hidden="true"></div>
          <ul class="principles">
            {
              principles.map((p, i) => (
                <li data-stagger style={`--i:${i}`}>
                  {p}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="closing-cta reveal" style="scroll-margin-top:96px">
        <div class="container">
          <img src="/musubi-enso.png" alt="" aria-hidden="true" />
          <h2>Let's tie the next piece together.</h2>
          <p>
            Tell us where the loose ends are. We'll help you connect them into something
            calm and dependable.
          </p>

          <button
            type="button"
            id="contact-toggle"
            class="cta-btn"
            data-umami-event="closing-cta-contact"
            aria-expanded="false"
            aria-controls="contact-form-wrap">Start a conversation</button
          >

          <div class="contact-form-wrap" id="contact-form-wrap" hidden>
            <form id="contact-form" class="contact-form" novalidate>
              <div class="form-row">
                <label for="cf-name">Name</label>
                <input id="cf-name" name="name" type="text" required maxlength="200" />
              </div>
              <div class="form-row">
                <label for="cf-email">Email</label>
                <input id="cf-email" name="email" type="email" required maxlength="200" />
              </div>
              <div class="form-row">
                <label for="cf-subject"
                  >Subject <span class="form-optional">(optional)</span></label
                >
                <input id="cf-subject" name="subject" type="text" maxlength="200" />
                <p class="form-hint">
                  Messages are scanned and triaged by hand — a clear subject makes it
                  easier for us to pick the thread back up.
                </p>
              </div>
              <div class="form-row">
                <label for="cf-message">Message</label>
                <textarea
                  id="cf-message"
                  name="message"
                  required
                  maxlength="5000"
                  rows="5"></textarea>
              </div>
              <!-- honeypot — hidden from real visitors, never labeled as real -->
              <div class="form-hp" aria-hidden="true">
                <input name="company" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <button type="submit" class="cta-btn" data-umami-event="contact-form-submit"
                >Send message</button
              >
              <p class="form-status" id="contact-form-status" role="status"></p>
            </form>
          </div>

          <p class="form-fallback">
            Prefer email? Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            directly.
          </p>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer-inner">
          <a href="#top" class="brand" aria-label="Musubi home">
            <img src="/isotype.png" alt="Musubi" width="28" height="28" />
            <span class="wordmark">Musubi</span>
          </a>
          <ul class="footer-nav">
            <li><a href="#capabilities" class="nav-link">Work</a></li>
            <li><a href="#philosophy" class="nav-link">Approach</a></li>
            <li>
              <a
                href={`mailto:${CONTACT_EMAIL}`}
                class="nav-link"
                data-umami-event="footer-contact">{CONTACT_EMAIL}</a
              >
            </li>
          </ul>
          <p class="footer-copyright">© {new Date().getFullYear()} Musubi</p>
        </div>
        <p class="credits">
          Onigiri isotype via <a
            href="https://www.vecteezy.com"
            target="_blank"
            rel="noopener noreferrer">Vecteezy.com</a
          >
        </p>
      </div>
    </footer>

    <script>
      (function () {
        const canvas = document.getElementById("hero-graph");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");

        const CLAY = "#E85D3D";
        const BLUE = "#1D4ED8";
        const INDIGO = "#2B4F82";
        const CARBON = "#323232";

        const N = 58; // node count
        let W = 0,
          H = 0,
          R = 0;
        let nodes3D = [],
          edges = [];
        let rotX = 0.18,
          rotY = 0;
        const mouse = { nx: 0.5, ny: 0.5, over: false }; // normalised 0-1

        // Fibonacci sphere — evenly distributed N points on unit sphere
        function buildSphere(radius) {
          const golden = Math.PI * (3 - Math.sqrt(5));
          return Array.from({ length: N }, (_, i) => {
            const y = 1 - (i / (N - 1)) * 2;
            const r = Math.sqrt(1 - y * y);
            const th = golden * i;
            // colour & size by index
            let color, nr;
            if (i === 0 || i === Math.round(N * 0.55)) {
              color = CLAY;
              nr = 6.5;
            } else if (i % 13 === 0) {
              color = CLAY;
              nr = 4.5;
            } else if (i % 7 === 0) {
              color = BLUE;
              nr = 4;
            } else if (i % 5 === 0) {
              color = INDIGO;
              nr = 3.5;
            } else {
              color = CARBON;
              nr = 2.4;
            }
            return {
              bx: r * Math.cos(th) * radius,
              by: y * radius,
              bz: r * Math.sin(th) * radius,
              // projected
              px: 0,
              py: 0,
              pz: 0,
              pscale: 1,
              color,
              r: nr,
            };
          });
        }

        // Connect nodes closer than `thresh` chord distance
        function buildEdges(ns, thresh) {
          const result = [];
          for (let i = 0; i < ns.length; i++) {
            for (let j = i + 1; j < ns.length; j++) {
              const dx = ns[i].bx - ns[j].bx;
              const dy = ns[i].by - ns[j].by;
              const dz = ns[i].bz - ns[j].bz;
              if (dx * dx + dy * dy + dz * dz < thresh * thresh) result.push([i, j]);
            }
          }
          return result;
        }

        function init() {
          const dpr = window.devicePixelRatio || 1;
          const rect = canvas.getBoundingClientRect();
          if (!rect.width) return;
          W = rect.width;
          H = rect.height;
          canvas.width = W * dpr;
          canvas.height = H * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          R = Math.min(W, H) * 0.46;
          nodes3D = buildSphere(R);
          edges = buildEdges(nodes3D, R * 0.72);
        }

        // Rotate (bx,by,bz) by angles rx (pitch) and ry (yaw)
        function rotatePoint(bx, by, bz, rx, ry) {
          const cy = Math.cos(ry),
            sy = Math.sin(ry);
          const x1 = bx * cy + bz * sy;
          const z1 = -bx * sy + bz * cy;
          const cx2 = Math.cos(rx),
            sx2 = Math.sin(rx);
          return { x: x1, y: by * cx2 - z1 * sx2, z: by * sx2 + z1 * cx2 };
        }

        // Perspective project
        function project(x, y, z) {
          const fov = 420;
          const s = fov / (fov + z + R * 0.6);
          return { px: W * 0.5 + x * s, py: H * 0.5 + y * s, scale: s };
        }

        function ringColor(color, alpha) {
          if (color === CLAY) return `rgba(232,93,61,${alpha})`;
          if (color === BLUE) return `rgba(37,99,235,${alpha})`;
          if (color === INDIGO) return `rgba(43,79,130,${alpha})`;
          return `rgba(50,50,50,${alpha})`;
        }

        let lastT = 0;
        function tick(t) {
          requestAnimationFrame(tick);
          if (!W || !H || !nodes3D.length) return;
          lastT = t;

          // Auto-rotate + gentle wobble
          rotY += 0.0035;
          const wobble = Math.sin(t * 0.00028) * 0.06;

          // Mouse tilt (lerp toward target)
          const targetX = mouse.over ? (mouse.ny - 0.5) * 0.9 : 0.18;
          const targetY = mouse.over ? rotY + (mouse.nx - 0.5) * 0.04 : rotY;
          rotX += (targetX - rotX) * 0.04;
          if (mouse.over) rotY += (mouse.nx - 0.5) * 0.02;

          // Project all nodes
          for (const n of nodes3D) {
            const { x, y, z } = rotatePoint(n.bx, n.by, n.bz, rotX + wobble, rotY);
            n.pz = z;
            const p = project(x, y, z);
            n.px = p.px;
            n.py = p.py;
            n.pscale = p.scale;
          }

          ctx.clearRect(0, 0, W, H);

          // Edges — depth-faded
          for (const [i, j] of edges) {
            const a = nodes3D[i],
              b = nodes3D[j];
            const avgZ = (a.pz + b.pz) / 2;
            const depth = (avgZ + R) / (2 * R); // 0 back → 1 front
            const alpha = (0.04 + depth * 0.13).toFixed(3);
            ctx.beginPath();
            ctx.moveTo(a.px, a.py);
            ctx.lineTo(b.px, b.py);
            ctx.strokeStyle = `rgba(17,17,19,${alpha})`;
            ctx.lineWidth = 0.7;
            ctx.stroke();
          }

          // Nodes — back-to-front (painter's algorithm)
          const sorted = nodes3D.slice().sort((a, b) => a.pz - b.pz);
          for (const n of sorted) {
            const depth = (n.pz + R) / (2 * R); // 0 back → 1 front
            const alpha = 0.28 + depth * 0.72;
            const nr = Math.max(n.r * n.pscale * (W / 280), 1);

            // Soft glow ring for larger front nodes
            if (depth > 0.6 && n.r >= 3.5) {
              ctx.beginPath();
              ctx.arc(n.px, n.py, nr + 3.5, 0, Math.PI * 2);
              ctx.fillStyle = ringColor(n.color, (alpha * 0.16).toFixed(3));
              ctx.fill();
            }

            ctx.globalAlpha = Math.min(alpha, 1);
            ctx.beginPath();
            ctx.arc(n.px, n.py, nr, 0, Math.PI * 2);
            ctx.fillStyle = n.color;
            ctx.fill();
            ctx.globalAlpha = 1;
          }
        }

        canvas.addEventListener("mousemove", (e) => {
          const r = canvas.getBoundingClientRect();
          mouse.nx = (e.clientX - r.left) / W;
          mouse.ny = (e.clientY - r.top) / H;
          mouse.over = true;
        });
        canvas.addEventListener("mouseleave", () => {
          mouse.over = false;
        });

        const ro = new ResizeObserver(() => {
          init();
        });
        ro.observe(canvas);

        init();
        requestAnimationFrame(tick);
      })();
    </script>

    <script>
      // Header scroll state
      const header = document.getElementById("site-header");
      const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Hero entrance
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced) {
        document.body.classList.add("is-loaded");
      } else {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.body.classList.add("is-loaded"))
        );
      }

      // Nav active section
      const sections = document.querySelectorAll("section[id]");
      const navLinks = document.querySelectorAll(".desktop-nav .nav-link[href^='#']");
      if (sections.length && navLinks.length) {
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                navLinks.forEach((link) =>
                  link.classList.toggle(
                    "is-active",
                    link.getAttribute("href") === `#${entry.target.id}`
                  )
                );
              }
            }
          },
          { rootMargin: "-30% 0px -60% 0px", threshold: 0 }
        );
        sections.forEach((s) => sectionObserver.observe(s));
      }
    </script>

    <script>
      const btn = document.getElementById("hamburger");
      const menu = document.getElementById("mobile-menu");

      function openMenu() {
        menu.classList.add("is-open");
        menu.setAttribute("aria-hidden", "false");
        btn.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }
      function closeMenu() {
        menu.classList.remove("is-open");
        menu.setAttribute("aria-hidden", "true");
        btn.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }

      btn.addEventListener("click", () => {
        btn.getAttribute("aria-expanded") === "true" ? closeMenu() : openMenu();
      });

      // Close on link click
      menu.querySelectorAll(".mobile-nav-link").forEach((a) => {
        a.addEventListener("click", closeMenu);
      });

      // Close on Escape
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeMenu();
      });
    </script>

    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealEls = document.querySelectorAll(".reveal");
      if (reduced) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>

    <script>
      const toggle = document.getElementById("contact-toggle");
      const wrap = document.getElementById("contact-form-wrap");
      const contactSection = document.getElementById("contact");
      if (toggle && wrap && contactSection) {
        toggle.addEventListener("click", () => {
          wrap.hidden = false;
          toggle.classList.add("is-hidden");
          toggle.setAttribute("aria-expanded", "true");
          requestAnimationFrame(() => wrap.classList.add("is-open"));
          document.getElementById("cf-name")?.focus();
        });

        // Collapse back to the toggle once the section scrolls fully out of
        // view, so it's always hidden-by-default on the way back in.
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting && !wrap.hidden) {
                wrap.classList.remove("is-open");
                wrap.hidden = true;
                toggle.classList.remove("is-hidden");
                toggle.setAttribute("aria-expanded", "false");
              }
            }
          },
          { threshold: 0 }
        );
        observer.observe(contactSection);
      }
    </script>

    <script>
      const form = document.getElementById("contact-form");
      const status = document.getElementById("contact-form-status");
      if (form && status) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const data = Object.fromEntries(new FormData(form as HTMLFormElement));
          const submitBtn = form.querySelector(
            'button[type="submit"]'
          ) as HTMLButtonElement;

          submitBtn.disabled = true;
          status.textContent = "Sending…";
          status.className = "form-status";

          try {
            const res = await fetch("/api/contact", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify(data),
            });
            const result = await res.json();

            if (res.ok && result.ok) {
              status.textContent = "Message sent — we'll get back to you soon.";
              status.className = "form-status form-status--ok";
              (form as HTMLFormElement).reset();
            } else {
              status.textContent =
                result.error ||
                "Something went wrong. Please try again or email us directly.";
              status.className = "form-status form-status--error";
            }
          } catch {
            status.textContent = "Network error. Please try again or email us directly.";
            status.className = "form-status form-status--error";
          } finally {
            submitBtn.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
